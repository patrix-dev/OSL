#include <stdio.h>
#include <stdlib.h>

int a[20], n, start;

void sort()
{
    int i, j, t;

    for (i = 0; i < n - 1; i++)
        for (j = i + 1; j < n; j++)
            if (a[i] > a[j])
            {
                t = a[i];
                a[i] = a[j];
                a[j] = t;
            }
}

void fcfs()
{
    int i, head = start, total = 0;

    printf("\nFCFS: %d", head);

    for (i = 0; i < n; i++)
    {
        total += abs(head - a[i]);
        head = a[i];
        printf(" -> %d", head);
    }

    printf("\nTotal movement = %d\n", total);
}

void sstf()
{
    int i, j, head = start, total = 0;
    int visited[20] = {0}, min, pos;

    printf("\nSSTF: %d", head);

    for (i = 0; i < n; i++)
    {
        min = 99999;

        for (j = 0; j < n; j++)
            if (!visited[j] && abs(head - a[j]) < min)
            {
                min = abs(head - a[j]);
                pos = j;
            }

        visited[pos] = 1;
        total += abs(head - a[pos]);
        head = a[pos];
        printf(" -> %d", head);
    }

    printf("\nTotal movement = %d\n", total);
}

void scan()
{
    int i, head = start, total = 0;

    printf("\nSCAN: %d", head);

    for (i = 0; i < n; i++)
        if (a[i] >= start)
        {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }

    total += abs(head - 199);
    head = 199;
    printf(" -> %d", head);

    for (i = n - 1; i >= 0; i--)
        if (a[i] < start)
        {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }

    printf("\nTotal movement = %d\n", total);
}

void cscan()
{
    int i, head = start, total = 0;

    printf("\nC-SCAN: %d", head);

    for (i = 0; i < n; i++)
        if (a[i] >= start)
        {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }

    total += abs(head - 199);
    head = 199;
    printf(" -> %d -> 0", head);

    total += 199;
    head = 0;

    for (i = 0; i < n; i++)
        if (a[i] < start)
        {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }

    printf("\nTotal movement = %d\n", total);
}

void look()
{
    int i, head = start, total = 0;

    printf("\nLOOK: %d", head);

    for (i = 0; i < n; i++)
        if (a[i] >= start)
        {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }

    for (i = n - 1; i >= 0; i--)
        if (a[i] < start)
        {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }

    printf("\nTotal movement = %d\n", total);
}

void clook()
{
    int i, head = start, total = 0;

    printf("\nC-LOOK: %d", head);

    for (i = 0; i < n; i++)
        if (a[i] >= start)
        {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }

    for (i = 0; i < n; i++)
        if (a[i] < start)
        {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }

    printf("\nTotal movement = %d\n", total);
}

int main()
{
    int i;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    if (n < 1 || n > 20)
    {
        printf("Invalid number of requests!\n");
        return 1;
    }

    printf("Enter requests: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter initial head position: ");
    scanf("%d", &start);

    fcfs();
    sstf();

    sort();

    scan();
    cscan();
    look();
    clook();

    return 0;
}
