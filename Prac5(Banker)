#include <stdio.h>

int main()
{
    int total[3], available[3];
    int alloc[5][3], max[5][3], need[5][3];
    int work[3], finish[5] = {0}, safe[5];
    int i, j, count, found, possible;
    int choice, p, request[3];

    printf("Enter total resources (A B C): ");
    for (i = 0; i < 3; i++)
        scanf("%d", &total[i]);

    printf("Enter Allocation matrix:\n");
    for (i = 0; i < 5; i++)
        for (j = 0; j < 3; j++)
            scanf("%d", &alloc[i][j]);

    printf("Enter Max matrix:\n");
    for (i = 0; i < 5; i++)
        for (j = 0; j < 3; j++)
            scanf("%d", &max[i][j]);

    for (j = 0; j < 3; j++)
    {
        int sum = 0;

        for (i = 0; i < 5; i++)
            sum += alloc[i][j];

        available[j] = total[j] - sum;
    }

    printf("\nNeed Matrix:\n");

    for (i = 0; i < 5; i++)
    {
        for (j = 0; j < 3; j++)
        {
            need[i][j] = max[i][j] - alloc[i][j];
            printf("%d\t", need[i][j]);
        }
        printf("\n");
    }

    for (j = 0; j < 3; j++)
        work[j] = available[j];

    count = 0;

    while (count < 5)
    {
        found = 0;

        for (i = 0; i < 5; i++)
        {
            if (finish[i] == 0)
            {
                possible = 1;

                for (j = 0; j < 3; j++)
                {
                    if (need[i][j] > work[j])
                    {
                        possible = 0;
                        break;
                    }
                }

                if (possible == 1)
                {
                    for (j = 0; j < 3; j++)
                        work[j] += alloc[i][j];

                    safe[count] = i;
                    finish[i] = 1;
                    count++;
                    found = 1;
                }
            }
        }

        if (found == 0)
            break;
    }

    if (count == 5)
    {
        printf("\nSystem is in SAFE state.\n");
        printf("Safe Sequence: ");

        for (i = 0; i < 5; i++)
        {
            printf("P%d", safe[i]);

            if (i != 4)
                printf(" -> ");
        }

        printf("\n");
    }
    else
    {
        printf("\nSystem is in UNSAFE state.\n");
        return 0;
    }

    printf("\nDo you want to make a resource request? (1=Yes, 0=No): ");
    scanf("%d", &choice);

    if (choice == 1)
    {
        printf("Enter process number (0-4): ");
        scanf("%d", &p);

        if (p < 0 || p >= 5)
        {
            printf("Invalid process number.\n");
            return 0;
        }

        printf("Enter request (A B C): ");

        for (j = 0; j < 3; j++)
            scanf("%d", &request[j]);

        for (j = 0; j < 3; j++)
        {
            if (request[j] < 0 || request[j] > need[p][j])
            {
                printf("Invalid request: Exceeds Need.\n");
                return 0;
            }

            if (request[j] > available[j])
            {
                printf("Resources not available. Process must wait.\n");
                return 0;
            }
        }

        for (j = 0; j < 3; j++)
        {
            available[j] -= request[j];
            alloc[p][j] += request[j];
            need[p][j] -= request[j];
        }

        for (j = 0; j < 3; j++)
            work[j] = available[j];

        for (i = 0; i < 5; i++)
            finish[i] = 0;

        count = 0;

        while (count < 5)
        {
            found = 0;

            for (i = 0; i < 5; i++)
            {
                if (finish[i] == 0)
                {
                    possible = 1;

                    for (j = 0; j < 3; j++)
                    {
                        if (need[i][j] > work[j])
                        {
                            possible = 0;
                            break;
                        }
                    }

                    if (possible == 1)
                    {
                        for (j = 0; j < 3; j++)
                            work[j] += alloc[i][j];

                        safe[count] = i;
                        finish[i] = 1;
                        count++;
                        found = 1;
                    }
                }
            }

            if (found == 0)
                break;
        }

        if (count == 5)
        {
            printf("\nRequest GRANTED.\n");
            printf("System is in SAFE state.\n");
            printf("Safe Sequence: ");

            for (i = 0; i < 5; i++)
            {
                printf("P%d", safe[i]);

                if (i != 4)
                    printf(" -> ");
            }

            printf("\n");
        }
        else
        {
            printf("\nRequest DENIED: System would become unsafe.\n");
        }
    }
    else
    {
        printf("No resource request made.\n");
    }

    return 0;
}
