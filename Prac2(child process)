#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    int a[20], n, i, j, temp;
    pid_t pid;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i=0; i<n; i++)
        scanf("%d", &a[i]);

    pid = fork();

    if(pid == 0)
    {
        printf("\nChild process sorting:\n");

        for(i=0; i<n-1; i++)
            for(j=0; j<n-i-1; j++)
                if(a[j] > a[j+1])
                {
                    temp=a[j];
                    a[j]=a[j+1];
                    a[j+1]=temp;
                }

        printf("Child sorted array: ");
        for(i=0; i<n; i++)
            printf("%d ", a[i]);
    }
    else if(pid > 0)
    {
        printf("\nParent process sorting:\n");

        for(i=0; i<n-1; i++)
            for(j=0; j<n-i-1; j++)
                if(a[j] > a[j+1])
                {
                    temp=a[j];
                    a[j]=a[j+1];
                    a[j+1]=temp;
                }

        printf("Parent sorted array: ");
        for(i=0; i<n; i++)
            printf("%d ", a[i]);

        wait(NULL);
        printf("\nChild process completed");
    }
    else
        printf("Fork failed");

    return 0;
}
