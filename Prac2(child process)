
#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>
#include <sys/wait.h>
#include <sys/types.h>

void sortAscending(int arr[], int n)
{
    int minIdx, temp;

    for (int i = 0; i < n - 1; i++)
    {
        minIdx = i;

        for (int j = i + 1; j < n; j++)
        {
            if (arr[j] < arr[minIdx])
            {
                minIdx = j;
            }
        }

        temp = arr[i];
        arr[i] = arr[minIdx];
        arr[minIdx] = temp;
    }

    for (int i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }
}

void sortDescending(int arr[], int n)
{
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (arr[j] < arr[j + 1])
            {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    for (int i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }
}

int main()
{
    pid_t pid;
    int status, n;

    printf("Enter the size of the array: ");
    if (scanf("%d", &n) != 1 || n < 1 || n > 100)
    {
        printf("Invalid array size!\n");
        return 1;
    }

    int arr[n];

    printf("Enter %d elements:\n", n);

    for (int i = 0; i < n; i++)
    {
        if (scanf("%d", &arr[i]) != 1)
        {
            printf("Invalid input!\n");
            return 1;
        }
    }

    pid = fork();

    if (pid < 0)
    {
        printf("Fork failed!\n");
        return 1;
    }
    else if (pid == 0)
    {
        printf("\n\nChild Process is executing...\n");
        printf("Child's ID: %d\n", getpid());
        printf("Child's Parent's ID: %d\n\n", getppid());

        printf("Array in Ascending Order: ");
        sortAscending(arr, n);

        printf("\n\n");
        system("ps");
        printf("\n");
        exit(0);
    }
    else
    {
        wait(&status);

        printf("\nParent Process is executing...\n");
        printf("Parent's ID: %d\n", getpid());
        printf("Child's ID: %d\n\n", pid);

        printf("Array in Descending Order: ");
        sortDescending(arr, n);

        printf("\n\n");
        system("ps");
        printf("\n");
    }

    return 0;
}
