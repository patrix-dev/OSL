#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

int buff[5];
int in = 0, out = 0;
int n, a[100];

sem_t f, e, s;

void *producer(void *arg)
{
    int data = *(int *)arg;

    sem_wait(&e);
    sem_wait(&s);

    buff[in] = data;
    printf("Produced: %d\n", data);
    in = (in + 1) % 5;

    sem_post(&s);
    sem_post(&f);

    return NULL;
}

void *consumer(void *arg)
{
    int data;

    for (int i = 0; i < n; i++)
    {
        sem_wait(&f);
        sem_wait(&s);

        data = buff[out];
        printf("Consumed: %d\n", data);
        out = (out + 1) % 5;

        sem_post(&s);
        sem_post(&e);
    }

    return NULL;
}

int main()
{
    pthread_t p[100], c;
    int i;

    printf("Enter number of items (maximum 100): ");
    scanf("%d", &n);

    if (n < 1 || n > 100)
    {
        printf("Invalid number of items!\n");
        return 1;
    }

    for (i = 0; i < n; i++)
    {
        printf("Enter item %d: ", i + 1);
        scanf("%d", &a[i]);
    }

    sem_init(&e, 0, 5);
    sem_init(&f, 0, 0);
    sem_init(&s, 0, 1);

    for (i = 0; i < n; i++)
    {
        pthread_create(&p[i], NULL, producer, &a[i]);
    }

    pthread_create(&c, NULL, consumer, NULL);

    for (i = 0; i < n; i++)
    {
        pthread_join(p[i], NULL);
    }

    pthread_join(c, NULL);

    sem_destroy(&e);
    sem_destroy(&f);
    sem_destroy(&s);

    return 0;
}
